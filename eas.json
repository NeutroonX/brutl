{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.18.0",
      "env": {
        "npm_config_legacy_peer_deps": "true",
        "EXPO_PUBLIC_SUPABASE_URL": null,
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": null
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "20.18.0",
      "env": {
        "npm_config_legacy_peer_deps": "true",
        "EXPO_PUBLIC_SUPABASE_URL": null,
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": null
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "20.18.0",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": null,
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": null
      }
    }
  },
  "submit": {
    "production": {}
  }
}
