{
  "expo": {
    "name": "brutl",
    "slug": "brutl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "brutl",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/logo.png",
      "supportsTablet": false
    },
    "android": {
      "icon": "./assets/images/logo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#000000",
        "monochromeImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.brutl.app",
      "permissions": [
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BRUTL to access your camera to scan food barcodes and photograph meals."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/images/logo.png",
            "imageWidth": 160,
            "resizeMode": "contain"
          }
        }
      ],
      "react-native-health-connect",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BRUTL to access your photos to set a profile picture."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5ad56e3-335c-4259-85d7-724e0ad03467"
      }
    }
  }
}
